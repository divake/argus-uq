  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repository",
      "name": "repository",
      "description": "Git repository holding the release; all files are under data_release/.",
      "contentUrl": "https://github.com/divake/argus-uq",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "per_item_full",
      "name": "per_item_full",
      "description": "16 open-weight + 12 closed-API per-item parquets",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "application/vnd.apache.parquet",
      "includes": "data_release/per_item_full/*.parquet"
    },
    {
      "@type": "cr:FileSet",
      "@id": "derived",
      "name": "derived",
      "description": "Canonical paper-numbers CSVs (29 files) computed via 50 random calibration/test splits",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "text/csv",
      "includes": "data_release/derived/*.csv"
    },
    {
      "@type": "cr:FileSet",
      "@id": "subsets",
      "name": "subsets",
      "description": "Locked stratified subset definitions (4 JSONs)",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "application/json",
      "includes": "data_release/subsets/*.json"
    },
    {
      "@type": "cr:FileSet",
      "@id": "closed_source_records",
      "name": "closed_source_records",
      "description": "Per-call API request + response records for closed-API cells (12 JSONLs; no API keys)",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "application/x-ndjson",
      "includes": "data_release/closed_source_records/*.records.jsonl"
    },
    {
      "@type": "cr:FileSet",
      "@id": "per_item_open",
      "name": "per_item_open",
      "description": "The 16 open-weight per-item parquets",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "application/vnd.apache.parquet",
      "includes": [
        "data_release/per_item_full/Q7x*.parquet",
        "data_release/per_item_full/Q72x*.parquet",
        "data_release/per_item_full/UIx*.parquet",
        "data_release/per_item_full/PTx*.parquet",
        "data_release/per_item_full/PxUIV*.parquet"
      ]
    },
    {
      "@type": "cr:FileSet",
      "@id": "per_item_closed",
      "name": "per_item_closed",
      "description": "The 12 closed-API per-item parquets",
      "containedIn": {
        "@id": "repository"
      },
      "encodingFormat": "application/vnd.apache.parquet",
      "includes": [
        "data_release/per_item_full/OAIx*.parquet",
        "data_release/per_item_full/Sonx*.parquet",
        "data_release/per_item_full/Gemx*.parquet"
      ]
    }
  ],
