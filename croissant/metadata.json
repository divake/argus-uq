  "citeAs": "@article{kumar2026uncertainty, title={Uncertainty Quantification for Computer-Use Agents: A Benchmark across Vision-Language Models and GUI Grounding Datasets}, author={Kumar, Divake and Tayebati, Sina and Naik, Devashri and Rios, Amanda Sofie and Ahuja, Nilesh and Tickoo, Omesh and Krishnan, Ranganath and Trivedi, Amit Ranjan}, journal={arXiv preprint arXiv:2606.25760}, year={2026}}",
